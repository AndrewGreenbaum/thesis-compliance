{
  "name": "thesis-check",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:lint-config": "node --test lint-tests/*.test.cjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "^16.4.2",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "overrides": {
    "@next/eslint-plugin-next@16.4.2": {
      "fast-glob": "file:../../../vendor/next-root-glob"
    },
    "eslint-config-next@16.4.2": {
      "eslint-plugin-react@7.37.5": {
        "eslint": "$eslint"
      },
      "eslint-plugin-import@2.32.0": {
        "eslint": "$eslint"
      },
      "eslint-plugin-jsx-a11y@6.10.2": {
        "eslint": "$eslint"
      }
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
